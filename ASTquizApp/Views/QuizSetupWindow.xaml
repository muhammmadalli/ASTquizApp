<Window x:Class="ASTquizApp.Views.QuizSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:resources="clr-namespace:ASTquizApp.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Setup"
        Height="450"
        Width="600"
        MinWidth="520"
        MinHeight="360">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Candidate input -->
            <RowDefinition Height="*"/>    <!-- Files list and actions -->
            <RowDefinition Height="Auto"/> <!-- Start button -->
            <RowDefinition Height="Auto"/> <!-- Footer / copyright -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="AST Quiz Test App"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Candidate name input -->
        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Candidate Name:"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Grid.Column="0"
                       Margin="0,0,10,0"/>

            <TextBox Name="CandidateNameBox"
                     Grid.Column="1"
                     Height="30"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Files list and select button -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <ListBox Name="FilesListBox"
                     Grid.Column="0"
                     Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Stretch">
                <Button Name="SelectFilesButton"
                        Content="Select Excel Files"
                        Height="36"
                        Margin="0,0,0,12"
                        Click="SelectFilesButton_Click"/>

                <TextBlock Text="Selected files will appear on the left."
                           FontSize="12"
                           Foreground="Gray"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Start button -->
        <Button Grid.Row="3"
                Name="StartQuizButton"
                Content="Start Quiz"
                Width="150"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,14,0,14"
                Click="StartQuizButton_Click"/>

        <!-- Footer -->
        <resources:CopyrightHeader Grid.Row="4"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,6,0,0"/>

    </Grid>

</Window>
