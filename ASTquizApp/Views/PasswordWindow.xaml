<Window x:Class="ASTquizApp.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrator Password"
        Height="240"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Administrator Password"
                   FontWeight="Bold"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- Password -->
        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="Password:"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="6,4,0,4"/>

        <!-- Number of Questions -->
        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Content="Number of Questions:"/>
        <TextBox x:Name="QuestionCountTextBox" Grid.Row="2" Grid.Column="1"
                 Width="100" Text="100" IsEnabled="False" Margin="6,4,0,4"/>

        <!-- Time Allowed -->
        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Content="Time Allowed (mins):"/>
        <TextBox x:Name="TimeAllowedTextBox" Grid.Row="3" Grid.Column="1"
                 Width="100" Text="60" IsEnabled="False" Margin="6,4,0,4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="80" Margin="6,0" Content="OK" Click="OK_Click" IsDefault="True"/>
            <Button Width="80" Margin="6,0" Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>

    </Grid>

</Window>
