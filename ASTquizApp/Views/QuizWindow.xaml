<Window x:Class="ASTquizApp.Views.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Quiz"
        Height="500"
        Width="700">


    <Grid Margin="25">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock
            Name="QuestionNumberText"
            FontSize="20"
            FontWeight="Bold"/>



        <TextBlock
            Grid.Row="1"
            Name="QuestionText"
            FontSize="22"
            TextWrapping="Wrap"
            Margin="0,20,0,20"/>



        <StackPanel
            Grid.Row="2">


            <RadioButton
                Name="OptionARadio"
                FontSize="18"
                Margin="5"/>


            <RadioButton
                Name="OptionBRadio"
                FontSize="18"
                Margin="5"/>


            <RadioButton
                Name="OptionCRadio"
                FontSize="18"
                Margin="5"/>


            <RadioButton
                Name="OptionDRadio"
                FontSize="18"
                Margin="5"/>


        </StackPanel>



        <Button
            Grid.Row="3"
            Name="NextButton"
            Content="Next"
            Width="120"
            Height="40"
            HorizontalAlignment="Right"
            Click="NextButton_Click"/>


    </Grid>


</Window>