<Window x:Class="ASTquizApp.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:ASTquizApp.Resources"
        
        Title="Result"
        Height="400"
        Width="500">

    <Grid Margin="30">

        <resources:CopyrightHeader/>
        
        <StackPanel>

            <TextBlock
                Text="QUIZ RESULT"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

            <TextBlock
                Name="ResultText"
                FontSize="20"/>

            <Button
                Name="GeneratePdfButton"
                Content="Generate PDF"
                Width="160"
                Height="40"
                Margin="0,30,0,0"
                Click="GeneratePdfButton_Click"/>

        </StackPanel>

    </Grid>

</Window>