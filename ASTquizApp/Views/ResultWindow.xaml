<Window x:Class="ASTquizApp.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:ASTquizApp.Resources"
        
        Title="AST Quiz Result"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="AST QUIZ RESULT"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,12,0,12"
            VerticalScrollBarVisibility="Auto">

            <Border BorderThickness="1"
                    BorderBrush="LightGray"
                    Padding="20"
                    Background="WhiteSmoke">

                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Name="CandidateText"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,6"
                               TextAlignment="Center"/>

                    <TextBlock Name="ScoreText"
                               FontSize="18"
                               Margin="0,6,0,6"
                               TextAlignment="Center"/>

                    <TextBlock Name="PercentageText"
                               FontSize="18"
                               Margin="0,6,0,0"
                               TextAlignment="Center"/>
                </StackPanel>

            </Border>

        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,8">

            <Button Name="GeneratePdfButton"
                    Content="Generate PDF"
                    Width="140"
                    Height="36"
                    Margin="8"
                    Click="GeneratePdfButton_Click"/>

            <Button Name="BackButton"
                    Content="Back to Quiz Setup"
                    Width="160"
                    Height="36"
                    Margin="8"
                    Click="BackButton_Click"/>

        </StackPanel>

        <resources:CopyrightHeader Grid.Row="3"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,6,0,0"/>

    </Grid>

</Window>